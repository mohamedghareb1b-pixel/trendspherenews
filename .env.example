DATABASE_URL=postgresql://user:password@localhost:5432/trendsphere
# لو مش عايز تركب Postgres منفصل: خد الـ Connection String من نفس مشروع Supabase
# (Settings → Database → Connection string → URI، اختار Connection pooling / Transaction mode)
NODE_ENV=development

# رابط الموقع - يُستخدم في SEO metadata, sitemap, RSS, الإيميلات
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude API - لتوليد SEO metadata / FAQ / Summary تلقائيًا (console.anthropic.com)
ANTHROPIC_API_KEY=

# Analytics (كلهم اختياريين - لو فاضيين، السكريبتات مش هتتحقن خالص)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# AdSense - عشان ads.txt يتولد صح (هتلاقيه في حسابك على AdSense شكله pub-xxxxxxxxxxxxxxxx)
ADSENSE_PUBLISHER_ID=

# مطلوب قانونيًا في إيميلات النشرة البريدية بأمريكا (CAN-SPAM Act) - عنوان بريدي فعلي للشركة/صاحب الموقع
# وبيتستخدم كمان في صفحة الـ DMCA كعنوان الـ Designated Agent
COMPANY_MAILING_ADDRESS=Abu Dahshan Street, Faqous, Sharqia Governorate, Egypt

# الإيميل الموحّد لكل "Contact Us" في الموقع (Privacy Policy, Terms, Cookie Policy, DMCA)
# غيّره هنا مكان واحد بس، وهيتحدث في كل الصفحات القانونية أوتوماتيك
CONTACT_EMAIL=

# Supabase Storage - لرفع صور المقالات (بتتحول WebP أوتوماتيك قبل الرفع)
# هتلاقيهم في: Supabase Project > Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=article-images

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# تسجيل دخول لوحة التحكم - غيّرهم لأي يوزرنيم/باسورد تحبه
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=you@example.com

# النشرة البريدية - أي SMTP حقيقي (Resend / Mailgun / Gmail App Password)
# ده لبعت إيميلات التأكيد والترحيب للمشتركين، مالوش علاقة بتسجيل دخولك انت
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=no-reply@trendsphere.com
